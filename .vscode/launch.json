{
    // Use inside the dev container. The "ros: debug env" task writes the ROS environment first.
    "version": "0.2.0",
    "configurations": [
        {
            // Pick a node; it runs with the parameters listed in inputs.node below
            // (edit the values there). scripts/debug_node.py runs the installed node in-process.
            "name": "ROS: debug node",
            "type": "debugpy",
            "request": "launch",
            "program": "/opt/workspace/scripts/debug_node.py",
            "args": ["${input:node}"],
            "envFile": "/opt/workspace/ros2_ws/install/debug.env",
            "preLaunchTask": "ros: debug env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: current file (ROS env)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "envFile": "/opt/workspace/ros2_ws/install/debug.env",
            "preLaunchTask": "ros: debug env",
            "console": "integratedTerminal"
        },
        {
            // Attach to a node started with: python3 -m debugpy --listen 5678 --wait-for-client ...
            "name": "ROS: attach to node (port 5678)",
            "type": "debugpy",
            "request": "attach",
            "connect": { "host": "localhost", "port": 5678 },
            "justMyCode": true
        }
    ],
    "inputs": [
        {
            // value: "<package> <executable> --ros-args -p <param>:=<value> ..."
            "id": "node",
            "type": "pickString",
            "description": "Node to debug (with its parameters)",
            "options": [
                { "label": "counter_pub   rate_hz:=1.0",
                  "value": "num_nodes counter_pub --ros-args -p rate_hz:=1.0" },
                { "label": "counter_sub   log_every:=1",
                  "value": "num_nodes counter_sub --ros-args -p log_every:=1" },
                { "label": "calc_server   introspection:=true",
                  "value": "num_nodes calc_server --ros-args -p introspection:=true" },
                { "label": "calc_client   operand:=1.0",
                  "value": "num_nodes calc_client --ros-args -p operand:=1.0" },
                { "label": "bag_recorder  datasets_dir:=/opt/workspace/datasets",
                  "value": "bag_tools bag_recorder --ros-args -p datasets_dir:=/opt/workspace/datasets" },
                { "label": "bag_player    datasets_dir:=/opt/workspace/datasets",
                  "value": "bag_tools bag_player --ros-args -p datasets_dir:=/opt/workspace/datasets" }
            ]
        }
    ]
}
